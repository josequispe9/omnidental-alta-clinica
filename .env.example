# Copiá este archivo como .env y completá los valores. El .env no se sube al repositorio.

# GHL - integración privada de AGENCIA (Settings > Private Integrations). La usan el paso 0 y el paso 6.
GHL_AGENCY_TOKEN=pit-...
# GHL - ID de la agencia (Settings > Company)
GHL_COMPANY_ID=...
# GHL - app de Marketplace (OAuth): da acceso a todas las subcuentas con una sola credencial
GHL_CLIENT_ID=...
GHL_CLIENT_SECRET=...

# Retell
RETELL_APIKEY=key_...

# URL pública del middleware (dominio fijo de ngrok)
MIDDLEWARE_URL=https://tu-dominio.ngrok-free.dev
