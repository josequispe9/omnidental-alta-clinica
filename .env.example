# Copiá este archivo como .env y completá los valores. El .env no se sube al repositorio.

# GHL - integración privada de AGENCIA (Settings > Private Integrations). La usan el paso 0 y el paso 6.
GHL_AGENCY_TOKEN=pit-...
# GHL - ID de la agencia (Settings > Company)
GHL_COMPANY_ID=...
# GHL - app de Marketplace (OAuth): da acceso a todas las subcuentas con una sola credencial
GHL_CLIENT_ID=...
GHL_CLIENT_SECRET=...

# Retell
RETELL_APIKEY=key_...

# URL pública del middleware (Vercel)
MIDDLEWARE_URL=https://omnidental-middleware.vercel.app

# Anthropic (Claude): la usa extraer_web.py para armar la ficha de la clínica desde su web
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (Postgres): cadena de conexión del "Session pooler" (Supabase > proyecto > Connect).
# Ej.: postgresql://postgres.<ref>:<contraseña>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://...
